@page "/"
@layout Layout.PublicLayout
@rendermode InteractiveServer

<main class="landing">
    <section class="landing-hero">
        <div class="landing-hero-content">
            <span class="landing-eyebrow">
                Gestão inteligente para negócios pet
            </span>

            <h1>
                Tudo o que seu negócio pet precisa.
                <span>Em um só lugar.</span>
            </h1>

            <p>
                Gerencie sua clínica veterinária, petshop, banho e tosa,
                hotel com uma plataforma pensada para simplificar sua rotina.
            </p>

            <div class="landing-hero-actions">
                <a href="/cadastro" class="landing-button landing-button-primary">
                    Começar agora
                </a>

                <a href="/login" class="landing-button landing-button-secondary">
                    Já tenho uma conta
                </a>
            </div>
        </div>
    </section>

    <section class="landing-features">
        <div class="landing-section-header">
            <span class="landing-eyebrow">
                Uma plataforma completa
            </span>

            <h2>
                Feita para acompanhar
                <span>seu negócio.</span>
            </h2>
        </div>

        <div class="landing-feature-grid">
            <article class="landing-feature-card">
                <h3>Clínica veterinária</h3>

                <p>
                    Prontuários, consultas, vacinas, exames,
                    prescrições e histórico completo dos animais.
                </p>
            </article>

            <article class="landing-feature-card">
                <h3>Petshop</h3>

                <p>
                    Clientes, produtos, estoque e vendas
                    organizados em um único sistema.
                </p>
            </article>

            <article class="landing-feature-card">
                <h3>Banho e tosa</h3>

                <p>
                    Agendamentos, serviços, profissionais
                    e acompanhamento dos pets.
                </p>
            </article>

            <article class="landing-feature-card">
                <h3>Hotel</h3>

                <p>
                    Controle de hospedagens, reservas, check-in,
                    check-out e acompanhamento dos pets durante a estadia.
                </p>
            </article>
        </div>
    </section>

    <section class="landing-how-it-works">
        <div class="landing-section-header">
            <span class="landing-eyebrow">
                Como funciona
            </span>

            <h2>
                Simples para começar.
                <span>Completo para crescer.</span>
            </h2>
        </div>

        <div class="landing-steps">
            <article class="landing-step">
                <span class="landing-step-number">
                    01
                </span>

                <h3>
                    Cadastre seu negócio
                </h3>

                <p>
                    Configure sua clínica, petshop ou operação
                    e cadastre profissionais, serviços e unidades.
                </p>
            </article>

            <article class="landing-step">
                <span class="landing-step-number">
                    02
                </span>

                <h3>
                    Organize sua rotina
                </h3>

                <p>
                    Gerencie clientes, pets, agenda, atendimentos
                    e operações em um único lugar.
                </p>
            </article>

            <article class="landing-step">
                <span class="landing-step-number">
                    03
                </span>

                <h3>
                    Tenha tudo sob controle
                </h3>

                <p>
                    Acompanhe sua operação, histórico dos animais
                    e evolução do negócio com mais clareza.
                </p>
            </article>
        </div>
    </section>

    <section class="landing-cta">
        <div>
            <span class="landing-eyebrow">
                PetSaas
            </span>

            <h2>
                Pronto para organizar
                <span>seu negócio?</span>
            </h2>

            <a href="/cadastro" class="landing-button landing-button-primary">
                Criar minha conta
            </a>
        </div>
    </section>
</main>